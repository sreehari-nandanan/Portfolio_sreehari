# GitHub OAuth Application credentials (Created at: GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Fine-grained Personal Access Token with repository Contents: Read and write permissions
# (Created at: GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens)
GITHUB_CONTENT_TOKEN=github_pat_your_fine_grained_token_here

# Target repository details
GITHUB_OWNER=sreehari-nandanan
GITHUB_REPO=Portfolio_sreehari
GITHUB_BRANCH=main

# Authorized administrator GitHub username (Only this user can log into the CMS)
ADMIN_GITHUB_USERNAME=sreehari-nandanan

# 32+ character random secret used to encrypt HTTP-only session cookies with AES-256-GCM
SESSION_SECRET=change_this_to_a_random_32_character_string_for_encryption

# Base URL of your application (used for OAuth redirects and CORS origin checks)
# Local: http://localhost:5173
# Production: https://your-portfolio-domain.vercel.app
APP_URL=http://localhost:5173
